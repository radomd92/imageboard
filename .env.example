# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
IMAGEBOARD_SECRET_KEY=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password
IMAGEBOARD_DATABASE_URL=postgresql+psycopg://imageboard:replace-with-a-random-database-password@database:5432/imageboard
IMAGEBOARD_FILE_SERVER=https://media-origin.example.internal/images
IMAGEBOARD_FILE_SERVER_USERNAME=imageboard
IMAGEBOARD_FILE_SERVER_PASSWORD=replace-me
IMAGEBOARD_FILE_SERVER_CA_BUNDLE=/run/secrets/media_ca.pem
IMAGEBOARD_TRUSTED_HOSTS=library.example.com
# Only set to the exact reverse-proxy source network(s), for example 127.0.0.1/32.
IMAGEBOARD_TRUSTED_PROXY_NETWORKS=127.0.0.1/32
IMAGEBOARD_HEALTH_TOKEN=replace-with-an-independent-32-character-random-token
IMAGEBOARD_RATE_LIMIT_STORAGE=redis://redis:6379/0
IMAGEBOARD_SECURE_COOKIES=true
IMAGEBOARD_ENABLE_HSTS=true
IMAGEBOARD_MAX_MEDIA_BYTES=262144000
IMAGEBOARD_MAX_DIRECTORY_BYTES=2097152
IMAGEBOARD_MAX_FORM_BYTES=65536
IMAGEBOARD_FILE_SERVER_CONNECT_TIMEOUT=3
IMAGEBOARD_FILE_SERVER_READ_TIMEOUT=20
IMAGEBOARD_MAX_STREAM_SECONDS=120
