# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
IMAGEBOARD_SECRET_KEY=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password
IMAGEBOARD_DATABASE_URL=postgresql+psycopg://imageboard:replace-with-a-random-database-password@database:5432/imageboard
IMAGEBOARD_MEDIA_ROOT=/absolute/path/to/media
IMAGEBOARD_TLS_CERT=/absolute/path/to/fullchain.pem
IMAGEBOARD_TLS_KEY=/absolute/path/to/privkey.pem
IMAGEBOARD_MEDIA_URL=/media
IMAGEBOARD_HEALTH_TOKEN=replace-with-an-independent-32-character-random-token
