user nginx;
worker_processes auto;
pid /run/nginx.pid;

events {
    worker_connections 512;
}

http {
    server_tokens off;
    access_log /var/log/nginx/media_access.log combined;
    error_log /var/log/nginx/media_error.log warn;

    limit_req_zone $binary_remote_addr zone=media_requests:10m rate=20r/s;
    limit_conn_zone $binary_remote_addr zone=media_connections:10m;

    server {
        listen 8443 ssl;
        listen [::]:8443 ssl;
        server_name media-origin.example.internal;

        ssl_certificate /run/secrets/media-origin.crt;
        ssl_certificate_key /run/secrets/media-origin.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        ssl_session_timeout 1d;

        disable_symlinks on from=$document_root;
        client_max_body_size 1k;
        limit_req zone=media_requests burst=40 nodelay;
        limit_conn media_connections 20;

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox" always;

        # Restrict this listener at the firewall to the Flask application host.
        location /images/ {
            alias /srv/media/;
            autoindex on;
            autoindex_format json;
            auth_basic "Media origin";
            auth_basic_user_file /run/secrets/media.htpasswd;
            limit_except GET { deny all; }
        }

        location ~ ^/images/(.+)§thumb§(large|small)$ {
            auth_basic "Media origin";
            auth_basic_user_file /run/secrets/media.htpasswd;
            limit_except GET { deny all; }

            set $source /$1;
            set $width 110;
            set $height 110;
            if ($2 = large) {
                set $width 220;
                set $height 220;
            }

            alias /srv/media/$source;
            image_filter crop $width $height;
            image_filter_jpeg_quality 90;
            image_filter_buffer 20M;
            image_filter_interlace on;
        }

        # Video thumbnail support requires a separately audited module. Keep it
        # disabled unless ngx_http_video_thumbextractor_module is installed.
        # location ~ ^/images/(.+)§vthumb$ { ... }
    }
}
